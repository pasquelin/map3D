{
  "name": "map3d",
  "version": "0.1.0",
  "description": "Bibliothèque React de cartographie 3D (Three.js + Google Photorealistic 3D Tiles) : globe, markers, clusters, tracés, dessin, entièrement thémable.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev:example": "vite --config examples/react/vite.config.ts",
    "build:example": "vite build --config examples/react/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "@armyc2.c5isr.renderer/mil-sym-ts-web": "^2.9.2",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "3d-tiles-renderer": "^0.5.0",
    "react-tooltip": "^6.0.8",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
