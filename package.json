{
  "name": "@pasquelin/map3d",
  "version": "0.1.1",
  "description": "Bibliothèque React de cartographie 3D (Three.js + Google Photorealistic 3D Tiles) : globe, markers, clusters, tracés, dessin, entièrement thémable.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Alban Pasquelin <alban.pasquelin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasquelin/map3D.git"
  },
  "homepage": "https://github.com/pasquelin/map3D#readme",
  "bugs": "https://github.com/pasquelin/map3D/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "react-doctor": "npx react-doctor@latest --no-telemetry",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "dev:example": "vite --config examples/react/vite.config.ts",
    "build:example": "vite build --config examples/react/vite.config.ts",
    "validater": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.0",
    "@armyc2.c5isr.renderer/mil-sym-ts-web": "^2.9.2",
    "@mapbox/vector-tile": "^3.0.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "earcut": "^3.2.3",
    "pbf": "^5.1.2",
    "react-tooltip": "^6.0.8",
    "supercluster": "^8.0.1",
    "three-mesh-bvh": "^0.9.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tweakpane/core": "^2.0.5",
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/stats.js": "^0.17.4",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stats.js": "^0.17.0",
    "three": "^0.169.0",
    "tweakpane": "^4.0.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
