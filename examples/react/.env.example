# Token Cesium Ion → Google Photorealistic 3D Tiles (seule source 3D externe).
# Sans token, l'exemple affiche le globe ellipsoïde de repli.
VITE_CESIUM_ION_TOKEN=

# Clé Google Maps Platform → fond 2D externe (Map Tiles), trafic, recherche de lieux,
# routage. Le fournisseur de tuiles `external` en a besoin ; `internal` non.
VITE_GOOGLE_MAPS_KEY=

# Origine du serveur de tuiles auto-hébergé — fournisseur `internal` de
# `providers.tiles`, qui est le DÉFAUT (ni clé ni session ni quota).
# Laissée vide, l'origine de `defaultConfig` s'applique, et le panneau permet de basculer
# entre production et serveur local. À renseigner pour viser une autre origine.
VITE_TILE_ORIGIN=

# Clé Windy Webcams API → plugin optionnel `windy` (dépôt voisin `plugingsMap3D`, cf.
# README.md de l'exemple). Facultative : le champ se renseigne aussi dans le hub des plugins.
VITE_WINDY_API_KEY=
