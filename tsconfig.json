{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // `ES2022.Error` seul, et non tout ES2022 : il ne débloque que `new Error(msg,
    // { cause })`, largement disponible (Chrome 93+, Safari 15+, Firefox 91+, soit
    // sous le plancher que WebGL 2 impose déjà). Le `target` reste ES2020.
    "lib": ["ES2020", "ES2022.Error", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
